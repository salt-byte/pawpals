# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── LangSmith 追踪（默认关闭）─────────────────────────────────────────
# 两个都设了才生效。只设 key 不会开启——避免别处配了 key 就偷偷开始上传。
#
# ⚠️ 开启意味着每次模型调用的完整输入输出都会上传到 LangSmith 并留存，
#    而这个应用的 prompt 里装着真实姓名、手机、邮箱和整份简历。请知情后再开。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxx
# LANGSMITH_PROJECT=pawpals

# ── 多用户模式 ─────────────────────────────────────────────────────────
# PAWPALS_MULTI_USER=1          # 邮箱账号 + 数据按用户隔离；未设为本地单人版
#
# ⚠️ 仅开发用：设了这个，多用户模式下跳过登录，一律把请求当成 local 用户处理。
#    真实部署绝对不能设——等于所有人共用同一份数据、没有任何鉴权。
# PAWPALS_DEV_NO_AUTH=1
#
# PAWPALS_DAILY_TOKEN_LIMIT=300000   # 每用户每日 token 上限；未设为不限
#
# PAWPALS_BACKUP_DIR=...          # 本地备份落盘位置；未设为 ~/Documents/PawPals备份
#
# 信任几层前置代理的 X-Forwarded-For。未设 = 0 = 一层都不信，只认 TCP 对端地址。
# 不设时登录限流按 remoteAddress 计；部署在 Railway / nginx / Cloudflare 这类
# 反向代理后面时必须显式设成代理层数（通常是 1），否则所有请求会被算成同一个 IP。
# ⚠️ 千万不要在没有前置代理时打开：那等于让任何人自带一个 X-Forwarded-For 就换一个
#    全新的限流桶，指数退避直接失效，密码只剩 scrypt 硬扛。
# PAWPALS_TRUST_PROXY=1
